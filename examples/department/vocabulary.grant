from numbers, text

kind area
kind role
kind room [ seats: one number ]
kind slot [
  day:   one number
  hour:  one number
  is:    role
]

kind course [
  title:     one text
  credits:   one number
  area:      one area
  requires:  course
  needs:     course
]

kind person [
  name:       one text
  is:         some role
  can_teach:  area
  passed:     course
  wants:      course
]

role lecturer
role student
role afternoon

rule afternoon: slot s is afternoon if s.hour >= 14
