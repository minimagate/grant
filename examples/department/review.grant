from numbers

world plan_morning
world plan_spread
world plan_merged

kind verdict
verdict best

kind world [
  + clashes_less_than:  world
  + spares_more_than:   world
  + is:                 verdict
]

rule clashes: world a clashes_less_than world b if
  count (in a: person s clashes_on slot k) < count (in b: person s clashes_on slot k)

rule spares: world a spares_more_than world b if
  count (in a: person t is overloaded) < count (in b: person t is overloaded)

rule best: world w is best if
  not world v clashes_less_than w and not world u spares_more_than w

? world a clashes_less_than world b
? world a spares_more_than world b
? world w is best

? in plan_morning: person s clashes_on slot k
? in plan_spread: cauchy.load

? (in plan_morning: riemann is overloaded) and not (in plan_merged: riemann is overloaded)

? plan_merged = plan_spread
? plan_merged = plan_merged
