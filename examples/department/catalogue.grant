from vocabulary

area algebra
area analysis
area geometry
area logic

subject linear_algebra
subject analysis_i
subject logic
subject analysis_ii
subject group_theory
subject topology
subject galois_theory
subject differential_geometry

course linear_algebra [
  subject:  linear_algebra
  credits:  9
  area:     algebra
]
course analysis_1 [
  subject:  analysis_i
  credits:  12
  area:     analysis
]
course logic_1 [
  subject:  logic
  credits:  6
  area:     logic
]
course analysis_2 [
  subject:   analysis_ii
  credits:   12
  area:      analysis
  requires:  analysis_1
]
course group_theory [
  subject:   group_theory
  credits:   6
  area:      algebra
  requires:  linear_algebra
]
course topology [
  subject:   topology
  credits:   9
  area:      geometry
  requires:  analysis_1
]
course galois_theory [
  subject:   galois_theory
  credits:   6
  area:      algebra
  requires:  group_theory
]
course differential_geometry [
  subject:   differential_geometry
  credits:   9
  area:      geometry
  requires:  topology, analysis_2, linear_algebra
]

rule needs: course c needs course p if c requires p or (c requires course q and q needs p)

never circular: course c where c needs c

? differential_geometry.needs
? course c and not c requires course p
? sum galois_theory.needs.credits
? area@algebra.course
? subject@logic.course
