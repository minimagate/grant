-- harbor: the full world of section 14

from numbers, text, id

kind city
kind feeling
kind condition

kind person [
  age:              one number
  lives_in:         one city
  knows:            person
  feels:            feeling
  is:               condition
  is_at:            condition
  is_neighbour_of:  person
  can_reach:        person
]

city pisa
city rome
feeling happy
condition peace
condition adult
condition lonely

person liz    [ age: 27 | lives_in: pisa ]
person laurie [ age: 30 | lives_in: rome ]
person harbor [ age: 24 | lives_in: pisa | knows: liz, laurie ]

harbor feels happy

rule calm:       person p is_at peace if p feels happy
rule mutual:     person a knows person b if b knows a
rule adult:      person p is adult if p.age >= 18
rule neighbours: person a is_neighbour_of person b if a.lives_in = b.lives_in and a != b
rule reach:      person a can_reach person b if a knows b or (a knows person m and m can_reach b)
rule lonely:     person p is lonely if not p knows person q

never sensible_age: person p where p.age < 0 or p.age > 150

? harbor is_at peace                -- yes
? liz.knows                         -- harbor
? person p is_neighbour_of harbor   -- liz
? harbor.id                         -- 3
? id.1                              -- pisa, happy, peace, liz
? person p and p.id < 3             -- liz, laurie
? sum harbor.knows.age / count harbor.knows   -- 28.5
? liz can_reach laurie              -- yes
? person p is lonely                -- nothing

harbor [ lives_in: rome | age: harbor.age + 1 ]
- harbor knows liz
- harbor feels happy

? harbor is_at peace                -- no
? harbor.age                        -- 25
? person p is_neighbour_of harbor   -- laurie
? person p is lonely                -- liz
